---
import { docsManualGroups, docsRoutes, repoUrl, withBase } from '../lib/site';
import { normalizeBase } from '../lib/base';

const rawBase = import.meta.env.BASE_URL;
const base = normalizeBase(rawBase);
const { title, eyebrow = 'Orbital field guide', lede } = Astro.props;
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const hrefFor = (href: string) => withBase(base, href);
const isActive = (href: string) => currentPath === hrefFor(href) || currentPath.endsWith(`/${href}`);
---
<section class="docs-layout">
  <aside class="docs-sidebar" aria-label="Docs navigation">
    <a class="docs-manual-brand" href={hrefFor('docs/')}>
      <span>SS</span>
      <strong>ORBIT MANUAL</strong>
    </a>
    <p class="docs-sidebar-copy">Find help by task, then go deeper into the physics or source.</p>

    <details class="docs-menu" data-doc-menu open>
      <summary>Browse documentation</summary>
      <div class="docs-menu-content">
        <label class="docs-filter-label" for="docs-route-filter">Find a help page</label>
        <input id="docs-route-filter" class="docs-filter" type="search" placeholder="Try pause, zoom, or build" data-doc-filter aria-describedby="docs-search-hint" />
        <p id="docs-search-hint" class="docs-route-count">Searches page titles, summaries, and task keywords.</p>
        <p class="docs-route-count" data-doc-count role="status">{docsRoutes.length} pages ready</p>
        <p data-doc-empty hidden>No matching pages. Try “controls” or “physics”, or clear the search to browse.</p>
        <button type="button" data-doc-clear hidden>Clear search</button>

        <nav aria-label="Documentation sections">
          {docsManualGroups.map((group) => (
            <div class="docs-nav-group" data-doc-group>
              <p>{group.title}</p>
              <div>
                {group.routes.map((route) => (
                  <a
                    class={`docs-nav-link${isActive(route.href) ? ' is-active' : ''}`}
                    href={hrefFor(route.href)}
                    aria-current={isActive(route.href) ? 'page' : undefined}
                    data-doc-route={`${route.code} ${route.label} ${route.summary} ${route.keywords ?? ''} ${group.title}`}
                  >
                    <span>{route.code}</span>
                    {route.label}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>

        <div class="docs-sidebar-actions" aria-label="Manual utility links">
          <a href={hrefFor('')}>← Solar atlas</a>
          <a href={hrefFor('simulator/')}>Launch simulator</a>
          <a href={repoUrl}>GitHub source</a>
        </div>
      </div>
    </details>
  </aside>

  <article class="docs-article">
    <header class="docs-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>
    <slot />
  </article>
</section>
<script is:inline>
  (() => {
    const input = document.querySelector('[data-doc-filter]');
    const count = document.querySelector('[data-doc-count]');
    const menu = document.querySelector('[data-doc-menu]');
    const routeItems = Array.from(document.querySelectorAll('[data-doc-route]'));
    const groups = Array.from(document.querySelectorAll('[data-doc-group]'));
    const compactLayout = window.matchMedia('(max-width: 980px)');
    const syncMenu = () => { if (menu) menu.open = !compactLayout.matches; };
    syncMenu();
    compactLayout.addEventListener('change', syncMenu);
    if (!input || !count || routeItems.length === 0) return;

    const applyFilter = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      routeItems.forEach((item) => {
        const haystack = (item.getAttribute('data-doc-route') || item.textContent || '').toLowerCase();
        const match = !query || haystack.includes(query);
        item.hidden = !match;
        if (match && item.classList.contains('manual-index-row')) visible += 1;
      });
      if (!document.querySelector('.manual-index-row')) {
        visible = routeItems.filter((item) => !item.hidden && item.classList.contains('docs-nav-link')).length;
      }
      groups.forEach((group) => {
        const children = Array.from(group.querySelectorAll('[data-doc-route]'));
        group.hidden = children.length > 0 && children.every((child) => child.hidden);
      });
      const routeNoun = visible === 1 ? 'page' : 'pages';
      count.textContent = query ? `${visible} matching ${routeNoun}` : `${visible} ${routeNoun} ready`;
      document.querySelector('[data-doc-empty]').hidden = visible > 0;
      document.querySelector('[data-doc-clear]').hidden = !query;
    };

    input.addEventListener('input', applyFilter);
    document.querySelector('[data-doc-clear]').addEventListener('click', () => { input.value = ''; applyFilter(); input.focus(); });
    applyFilter();
  })();
</script>
