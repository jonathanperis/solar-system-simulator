---
import { normalizeBase } from '../lib/base';
// Present only for deployed main builds (V17); the page CSP allow-lists the
// Google hosts under the same condition (src/lib/csp.ts).
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const base = normalizeBase(import.meta.env.BASE_URL);
---

{GA_ID && (
  <>
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script is:inline defer src={`${base}scripts/analytics.js`} data-ga-id={GA_ID}></script>
  </>
)}
