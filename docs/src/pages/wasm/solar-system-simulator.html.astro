---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { normalizeBase } from '../../lib/base';
// Compatibility page for the historic Emscripten URL. Astro renders it with the
// shared layout (CSP, generator marker); the `legacyHtmlRoutes` integration in
// astro.config.mjs publishes it at the exact old filename.
const base = normalizeBase(import.meta.env.BASE_URL);
---
<BaseLayout title="Moved" description="The simulator is now the home page." redirectTo="">
  <div class="page">
    <h1>The simulator moved.</h1>
    <p>It is now the <a href={base}>home page</a>.</p>
  </div>
</BaseLayout>
