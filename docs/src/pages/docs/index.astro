---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsShell from '../../components/DocsShell.astro';
import { docsManualGroups, docsRoutes, repoUrl, withBase } from '../../lib/site';
import { normalizeBase } from '../../lib/base';

const base = normalizeBase(import.meta.env.BASE_URL);
const totalRoutes = docsRoutes.length;
const wasmRoute = withBase(base, 'simulator/');
---
<BaseLayout title="Orbital field guide">
  <DocsShell
    eyebrow="Reference / orbital field guide"
    title="Find your way around the solar system."
    lede="Start with your first orbit, find a control, or follow a question into the physics. Source and build references are here when you need them."
  >
    <section class="manual-hero" aria-label="Orbit manual summary">
      <div class="manual-hero-copy">
        <p class="eyebrow">ORBIT MANUAL / FIELD NOTES</p>
        <h2>New here? Watch your first orbit.</h2>
        <p>
          Choose Earth and the Moon, pause the scene, and discover how motion changes your view. You do not need to know the equations or write any code to begin.
        </p>
        <div class="manual-chip-row" aria-label="Manual diagnostics">
          <span>Explore at your own pace</span>
          <span>Desktop, keyboard, and touch</span>
        </div>
        <div class="manual-actions" aria-label="Primary manual actions">
          <a class="button" href={withBase(base, 'docs/experiments/')}>Your first orbit</a>
          <a class="button button-secondary" href={wasmRoute}>Open simulator</a>
        </div>
      </div>
      <aside class="manual-stats" aria-label="Documentation stats">
        <p>ROUTES</p>
        <strong>{totalRoutes}</strong>
        <span>FOCUSED MANUAL PAGES</span>
        <dl>
          {docsManualGroups.map((group) => (
            <>
              <dt>{group.title}</dt>
              <dd>{group.routes.length}</dd>
            </>
          ))}
        </dl>
      </aside>
    </section>

    <section class="manual-routes" aria-labelledby="manual-routes-title">
      <p class="eyebrow">Solar manual routes</p>
      <h2 id="manual-routes-title">Pick a route by job, not by scroll depth.</h2>
      <div class="manual-route-grid">
        {docsManualGroups.map((group) => (
          <article class="manual-route-card" data-doc-group>
            <p>{group.id}</p>
            <h3>{group.title}</h3>
            <span class="manual-card-rule" aria-hidden="true"></span>
            <p>{group.description}</p>
            <div class="manual-route-links">
              {group.routes.map((route) => (
                <a
                  class="manual-route-link"
                  href={withBase(base, route.href)}
                   data-doc-route={`${route.code} ${route.label} ${route.summary} ${route.keywords ?? ''} ${group.title}`}
                >
                  <span>{route.code}</span>
                  <strong>{route.label}</strong>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="manual-index" aria-labelledby="manual-index-title">
      <div class="manual-index-heading">
        <div>
          <p class="eyebrow">Full index</p>
          <h2 id="manual-index-title">Every orbit manual page</h2>
        </div>
        <a href={repoUrl}>Open source →</a>
      </div>
      <div class="manual-index-list">
        {docsRoutes.map((route, index) => (
          <a
            class="manual-index-row"
            href={withBase(base, route.href)}
            data-doc-route={`${route.code} ${route.label} ${route.summary} ${route.keywords ?? ''}`}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{route.label}</strong>
            <em>{route.summary}</em>
          </a>
        ))}
      </div>
    </section>
    <section class="doc-panel">
      <h2>Atlases and reference collections</h2>
      <ul>
        <li><a href={`${base}`}>Illustrated solar atlas</a> — select a world and discover its family.</li>
        <li><a href={`${base}body-catalog/`}>Bodies in the simulator</a> — search planets, moons, and Vesta.</li>
        <li><a href={`${base}small-bodies/`}>Small-body atlas</a> — explore the pinned catalog and build an experiment.</li>
        <li><a href={`${base}physics/`}>Physics and model limits</a> — understand what the simulation measures.</li>
        <li><a href={`${base}source-atlas/`}>Source atlas</a> — locate the code behind each feature.</li>
        <li><a href={`${base}pipeline/`}>Build and delivery pipeline</a> — follow verification through to publication.</li>
      </ul>
    </section>
  </DocsShell>
</BaseLayout>
