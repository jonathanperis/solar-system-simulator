---
import BaseLayout from '../layouts/BaseLayout.astro';
import { normalizeBase } from '../lib/base';
import { buildRevision } from '../lib/site';
import { lessonOptions, sceneNames } from '../lib/lessonCatalog';
import { coreBodyCount, jovianMoonCount, saturnianMoonCount, uranianMoonCount, neptunianMoonCount, plutonianMoonCount } from '../lib/siteCounts';

// The simulator is the homepage (DESIGN.md, SPEC A100). Every control talks to
// the C runtime through src/lib/simulator.ts; this page only lays them out.
const base = normalizeBase(import.meta.env.BASE_URL);
const sceneIndex = (scene: string) => lessonOptions.findIndex(([name]) => name === scene);
const sceneChoices = [
  { index: sceneIndex('core'), label: `Solar system (${coreBodyCount})` },
  { index: sceneIndex('jupiter-system'), label: `Jupiter (${jovianMoonCount} moons)` },
  { index: sceneIndex('saturn-system'), label: `Saturn (${saturnianMoonCount} moons)` },
  { index: sceneIndex('uranus-system'), label: `Uranus (${uranianMoonCount} moons)` },
  { index: sceneIndex('neptune-system'), label: `Neptune (${neptunianMoonCount} moons)` },
  { index: sceneIndex('pluto-system'), label: `Pluto (${plutonianMoonCount} moons)` },
  { index: sceneIndex('didymos-system'), label: 'Didymos (DART)' },
  { index: sceneIndex('patroclus-system'), label: 'Patroclus (trojan)' }
];
// Guided lessons load into the lesson strip; the main scene stays reachable there too.
const lessonChoices = lessonOptions.map(([name, label], index) => ({ name, label, index }))
  .filter(({ name }) => name === 'core' || !sceneNames.includes(name));
---
<BaseLayout variant="instrument" description="Live C11 and raylib solar system in the browser: SI-unit N-body physics starting from the real sky of 2026-06-09.">
  <section class="instrument" data-simulator data-catalog-manifest={`${base}catalog/manifest.json`} data-runtime-src={`${base}wasm/solar-system-simulator.js?revision=${encodeURIComponent(buildRevision)}`} aria-label="Solar system simulator">
    <div class="canvas-wrap">
      {/* role="application": the focused canvas consumes single-key shortcuts. */}
      <canvas id="canvas" tabindex="0" role="application" aria-roledescription="3D simulation view"
        aria-label="Live solar system simulation" aria-describedby="canvas-keys runtime-control-state">
        Your browser needs canvas and WebGL to display the simulation.
      </canvas>
      <p id="canvas-keys" class="sr-only">With the view focused: Space pauses, N steps, R restarts, V switches scale, F frames the system, B frames the body, A toggles rotation, G grid, H labels, C cycles bodies, O orbits, brackets change speed. Tab leaves the view.</p>
    </div>

    {/* The sky clock leads the view: the date is the one reading that always
         matters, so it sits on the canvas rather than among the controls. */}
    <div class="hud">
      <div class="clock" role="group" aria-label="Simulation clock">
        <output class="clock-time" data-runtime-elapsed>—</output>
        <p class="clock-note" data-clock-note></p>
      </div>
      <p class="hud-line"><span data-active-scene>—</span> · <span data-runtime-status role="status" aria-live="polite">Downloading simulator…</span></p>
      <p id="runtime-control-state" class="sr-only" data-runtime-controls role="status" aria-live="polite">Waiting for simulation state.</p>
      <p data-scene-status role="status"></p>
    </div>

    <div class="lesson-strip" data-lesson-strip hidden>
      <fieldset data-runtime-panel disabled>
        <legend class="sr-only">Lesson</legend>
        <label>Lesson <select data-lesson>
          {lessonChoices.map(({ label, index }) => <option value={index}>{label}</option>)}
          <option value="-1" disabled>Catalog experiment</option>
        </select></label>
        <label>Method <select data-integrator><option value="0">Verlet</option><option value="1">Euler</option></select></label>
        <label>Step (s) <input type="number" data-dt min="0.01" max="3600" step="any" value="15" required /></label>
        <label>Speed × <input type="number" data-velocity-factor min="0.1" max="2" step="any" value="1" required /></label>
        <button type="button" data-apply-lesson>Load</button>
        <button type="button" data-command="contact" hidden>Contact: bounce</button>
        <p data-lesson-status role="status"></p>
      </fieldset>
    </div>

    <aside class="inspector instrument-panel" aria-labelledby="inspector-heading">
      <h2 id="inspector-heading" data-inspector-name>—</h2>
      <dl>
        <dt>Parent</dt><dd data-inspector-parent>—</dd>
        <dt>Distance</dt><dd data-inspector-distance>—</dd>
        <dt>Speed</dt><dd data-inspector-speed>—</dd>
        <dt>Period</dt><dd data-inspector-period>—</dd>
        <dt>Mass</dt><dd data-inspector-mass>—</dd>
        <dt>Radius</dt><dd data-inspector-radius>—</dd>
      </dl>
      <fieldset data-runtime-panel disabled class="row">
        <legend class="sr-only">Framing</legend>
        <button type="button" data-command="frame">Frame system</button>
        <button type="button" data-command="frameBody">Frame body</button>
        <button type="button" data-whole-system>Whole scene</button>
      </fieldset>
    </aside>

    <div class="dock instrument-panel">
      <fieldset data-runtime-panel disabled>
        <legend class="sr-only">Playback and scene</legend>
        <button type="button" data-command="pause">Pause</button>
        <button type="button" data-command="reset">Restart</button>
        <label class="speed">Speed <span class="speed-row"><input type="range" data-runtime-speed min="0" max="4" step="1" value="1" aria-valuetext="1 day / second" /> <output data-speed-label>1 d/s</output></span></label>
        <label>Scene <select data-runtime-scene>
          {sceneChoices.map(({ index, label }) => <option value={index}>{label}</option>)}
          <option value="" disabled>Lesson or experiment</option>
        </select></label>
        <button type="button" data-command="tour" aria-pressed="false">Tour</button>
        <button type="button" data-open-panel="find-panel" aria-haspopup="dialog">Find</button>
        <button type="button" data-open-panel="view-panel" aria-haspopup="dialog">View</button>
        <button type="button" data-open-panel="keys-panel" aria-haspopup="dialog">Keys</button>
        <button type="button" data-open-panel="advanced-panel" aria-haspopup="dialog">Data</button>
      </fieldset>
    </div>

    <dialog id="find-panel" class="sheet" aria-labelledby="find-heading">
      <header><h2 id="find-heading">Find a body</h2><button type="button" data-close-panel aria-label="Close find">Close</button></header>
      <fieldset class="body" data-runtime-panel disabled>
        <legend class="sr-only">Find a body</legend>
        <div class="row">
          <label>Name <input type="search" data-runtime-search placeholder="Titan, S/2021 J 8…" /></label>
          <label>Group <select data-runtime-group><option value="">All groups</option></select></label>
          <button type="button" data-clear-filters>Clear</button>
        </div>
        {/* A130: live matches; a click or Enter flies to the first. */}
        <div class="find-results" data-find-results role="group" aria-label="Matches" hidden></div>
        <label>Body <select data-runtime-body></select></label>
        <p data-body-filter-status role="status"></p>
        <p>Small moons live in their planet's scene: switch the scene first, or open a moon from the <a href={`${base}catalog/`}>catalog</a>.</p>
        <button type="button" data-close-panel>Show</button>
      </fieldset>
    </dialog>

    <dialog id="view-panel" class="sheet popover" aria-labelledby="view-heading">
      <header><h2 id="view-heading">View</h2><button type="button" data-close-panel aria-label="Close view">Close</button></header>
      {/* Non-modal (A128): the scene stays visible while it changes. */}
      <fieldset class="body view-groups" data-runtime-panel disabled>
        <legend class="sr-only">View</legend>
        <div class="view-group">
          <span class="group-label" id="scale-label">Scale</span>
          <div class="segmented" role="group" aria-labelledby="scale-label">
            <button type="button" data-scale="Illustrative" aria-pressed="true">Illustrative</button>
            <button type="button" data-scale="Real scale" aria-pressed="false">Real</button>
          </div>
        </div>
        <div class="view-group">
          <span class="group-label">Show</span>
          <div class="switches">
            <button type="button" role="switch" aria-checked="true" data-command="orbits">Orbits</button>
            <button type="button" role="switch" aria-checked="true" data-command="belt">Asteroids</button>
            <button type="button" role="switch" aria-checked="false" data-command="constellations">Constellations</button>
            <button type="button" role="switch" aria-checked="true" data-command="labels">Labels</button>
            <button type="button" role="switch" aria-checked="true" data-command="grid">Grid</button>
            <button type="button" role="switch" aria-checked="false" data-command="vectors">Vectors</button>
          </div>
        </div>
        <div class="view-group">
          <span class="group-label" id="trails-label">Trails around</span>
          <div class="segmented" role="group" aria-labelledby="trails-label">
            <button type="button" data-trail-frame="1" aria-pressed="true">Parent</button>
            <button type="button" data-trail-frame="0" aria-pressed="false">Sun</button>
          </div>
        </div>
        <div class="view-group">
          <span class="group-label">Camera</span>
          <div class="camera-row">
            <button type="button" role="switch" aria-checked="true" data-command="rotate" data-runtime-rotate>Rotate</button>
            <button type="button" role="switch" aria-checked="false" data-command="follow">Follow</button>
            <div class="segmented" role="group" aria-label="Zoom">
              <button type="button" data-command="zoom" data-value="-1" aria-label="Zoom out">−</button>
              <button type="button" data-command="zoom" data-value="1" aria-label="Zoom in">+</button>
            </div>
          </div>
        </div>
      </fieldset>
    </dialog>

    <dialog id="keys-panel" class="sheet" aria-labelledby="keys-heading">
      <header><h2 id="keys-heading">Keys</h2><button type="button" data-close-panel aria-label="Close keys">Close</button></header>
      <div class="body">
        <dl class="keys">
          <dt><kbd>Space</kbd></dt><dd>pause or resume</dd>
          <dt><kbd>N</kbd></dt><dd>one step while paused</dd>
          <dt><kbd>R</kbd></dt><dd>restart</dd>
          <dt><kbd>[</kbd> <kbd>]</kbd></dt><dd>slower, faster</dd>
          <dt><kbd>C</kbd> <kbd>1</kbd>–<kbd>0</kbd></dt><dd>cycle or pick bodies</dd>
          <dt><kbd>F</kbd> <kbd>B</kbd></dt><dd>frame system, frame body</dd>
          <dt><kbd>V</kbd> <kbd>A</kbd></dt><dd>scale, camera rotation</dd>
          <dt><kbd>O</kbd> <kbd>T</kbd> <kbd>X</kbd></dt><dd>orbits, trails, vectors</dd>
          <dt><kbd>G</kbd> <kbd>H</kbd></dt><dd>grid, labels</dd>
          <dt>Wheel, drag, pinch, twist</dt><dd>zoom, turn the view</dd>
          <dt>Long press</dt><dd>a body's numbers</dd>
          <dt>Point, click</dt><dd>name a body, fly to it</dd>
          <dt><kbd>Esc</kbd> <kbd>Backspace</kbd></dt><dd>step out, go back</dd>
          <dt><kbd>←</kbd> <kbd>→</kbd> <kbd>↑</kbd> <kbd>↓</kbd></dt><dd>next body, parent, moons</dd>
          <dt><kbd>/</kbd> <kbd>Y</kbd></dt><dd>search, follow orbit</dd>
          <dt><kbd>Q</kbd> <kbd>S</kbd></dt><dd>asteroid belt, constellations</dd>
          <dt>Double-click</dt><dd>whole family</dd>
        </dl>
        <p>Keys work while the view has focus. Tab moves through the controls.</p>
      </div>
    </dialog>

    <dialog id="advanced-panel" class="sheet" aria-labelledby="advanced-heading">
      <header><h2 id="advanced-heading">Data</h2><button type="button" data-close-panel aria-label="Close data">Close</button></header>
      <fieldset class="body" data-runtime-panel disabled>
        <legend class="sr-only">Measurements and experiments</legend>
        <div class="row">
          <button type="button" data-command="step" disabled>Step +15 s</button>
          <button type="button" data-export>Download CSV</button>
        </div>
        <p data-export-status role="status"></p>
        <details>
          <summary id="diagnostics-heading">Numbers</summary>
          <dl>
            <dt>Trail spacing</dt><dd data-runtime-interval>—</dd>
            <dt>Achieved speed</dt><dd data-runtime-achieved>—</dd>
            <dt>Pending time</dt><dd data-runtime-pending>—</dd>
            <dt>Integrator</dt><dd data-integration>—</dd>
            <dt>Energy</dt><dd data-energy>—</dd>
            <dt>Energy change</dt><dd data-energy-change>—</dd>
            <dt>Momentum</dt><dd data-momentum>—</dd>
            <dt>Angular momentum</dt><dd data-angular-momentum>—</dd>
            <dt>Acceleration</dt><dd data-inspector-acceleration>—</dd>
            <dt>Specific energy</dt><dd data-inspector-specific-energy>—</dd>
            <dt>Position</dt><dd data-inspector-position>—</dd>
            <dt>Velocity</dt><dd data-inspector-velocity>—</dd>
            <dt>Magnification</dt><dd data-magnification>—</dd>
            <dt>Camera</dt><dd data-runtime-camera>—</dd>
          </dl>
        </details>
        <details>
          <summary>Gravity sources at <span data-forces-time>—</span></summary>
          <div class="table-wrap"><table><thead><tr><th>Source</th><th>Acceleration</th><th>Share</th><th>X, Y, Z (m/s²)</th></tr></thead><tbody data-runtime-forces></tbody></table></div>
        </details>
        <div class="row">
          <a href={`${base}catalog/small-bodies/`}>Choose small bodies</a>
          <button type="button" data-start-experiment>Start prepared experiment</button>
          <button type="button" data-demo>Main scene</button>
        </div>
        <p data-experiment-status role="status"></p>
        <p>All values are SI and come from the C runtime. <a href={`${base}about/#model`}>How the model works</a>.</p>
      </fieldset>
    </dialog>

    <noscript><p class="hud">JavaScript is required to run the WebAssembly simulator. <a href={`${base}about/`}>Read how it works</a>.</p></noscript>
  </section>
</BaseLayout>

<script>
  import { mountSimulator } from '../lib/simulator';
  const root = document.querySelector<HTMLElement>('[data-simulator]');
  if (root) mountSimulator(root);
</script>
