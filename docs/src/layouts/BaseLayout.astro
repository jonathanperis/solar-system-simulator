---
import Analytics from '../components/Analytics.astro';
import FooterCredits from '../components/FooterCredits.astro';
import { primaryRoutes, siteName, withBase } from '../lib/site';
import { normalizeBase } from '../lib/base';

const rawBase = import.meta.env.BASE_URL;
const base = normalizeBase(rawBase);
const pageTitle = Astro.props.title;
const title = pageTitle ? `${pageTitle} · ${siteName}` : siteName;
const defaultDescription = 'A physics-first C and raylib solar-system lab with a browser WebAssembly demo and source-backed Astro docs.';
const description = Astro.props.description || (pageTitle ? `${pageTitle}. ${defaultDescription}` : defaultDescription);
const canonicalUrl = new URL(Astro.url.pathname, 'https://jonathanperis.github.io').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}styles/global.css`} />
    <Analytics />
  </head>
  <body class={pageTitle ? 'secondary-page' : 'home-page'}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" data-site-header>
      <a class="brand" href={base} aria-label="Solar System Simulator home">
        <span class="brand-mark">☉</span>
        <span>{siteName}</span>
      </a>
      <nav class="primary-nav" aria-label="Main navigation">
        {primaryRoutes.map((route) => <a href={withBase(base, route.href)}>{route.label}</a>)}
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <FooterCredits />
  </body>
</html>
