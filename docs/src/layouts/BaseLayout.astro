---
import Analytics from '../components/Analytics.astro';
import FooterCredits from '../components/FooterCredits.astro';
import { primaryRoutes, siteName, withBase } from '../lib/site';
import { normalizeBase } from '../lib/base';
import { contentSecurityPolicy } from '../lib/csp';

interface Props {
  title?: string;
  description?: string;
  /** Base-relative target for compatibility pages that forward to a canonical route. */
  redirectTo?: string;
}

const rawBase = import.meta.env.BASE_URL;
const base = normalizeBase(rawBase);
const pageTitle = Astro.props.title;
const title = pageTitle ? `${pageTitle} · ${siteName}` : siteName;
const defaultDescription = 'A C11 orbital mechanics lab with a raylib/WebAssembly simulator, matched A/B experiments, a pinned small-body atlas, and source-backed learning guides.';
const description = Astro.props.description || (pageTitle ? `${pageTitle}. ${defaultDescription}` : defaultDescription);
const redirectTarget = Astro.props.redirectTo ? withBase(base, Astro.props.redirectTo) : undefined;
const canonicalUrl = new URL(redirectTarget ?? Astro.url.pathname, 'https://jonathanperis.github.io').href;
const csp = contentSecurityPolicy(Boolean(import.meta.env.PUBLIC_GA_ID));
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const activeRoute = primaryRoutes.find(route => route.paths.some(path => currentPath === withBase(base, path)))
  ?? primaryRoutes.find(route => route.paths.some(path => path && currentPath.startsWith(withBase(base, path))));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* First in <head>: a meta CSP governs only resources requested after it. */}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Route validation requires this marker on every published HTML document (A60). */}
    <meta name="generator" content={Astro.generator} />
    {redirectTarget && <meta http-equiv="refresh" content={`0;url=${redirectTarget}`} />}
    {redirectTarget && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    {/* Self-hosted OFL fonts (public/fonts). Preload the two upright faces used
        above the fold; the italic face loads on demand. */}
    <link rel="preload" href={`${base}fonts/cormorant-garamond-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/jetbrains-mono-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={`${base}styles/global.css`} />
    <slot name="head" />
    <Analytics />
  </head>
  <body class={pageTitle ? 'secondary-page' : 'home-page'}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" data-site-header>
      <a class="brand" href={base} aria-label="Solar System Simulator home">
        <span class="brand-mark">☉</span>
        <span>{siteName}</span>
      </a>
      <nav class="primary-nav" aria-label="Main navigation">
        {primaryRoutes.map((route) => (
          <a
            href={withBase(base, route.href)}
            aria-current={activeRoute === route ? currentPath === withBase(base, route.href) ? 'page' : 'location' : undefined}
            data-primary-nav-link
          >
            {route.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <FooterCredits />
  </body>
</html>
