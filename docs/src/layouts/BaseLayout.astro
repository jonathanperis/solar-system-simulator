---
import Analytics from '../components/Analytics.astro';
import { authorName, buildRevision, primaryRoutes, repoUrl, siteName, withBase } from '../lib/site';
import { normalizeBase } from '../lib/base';
import { contentSecurityPolicy } from '../lib/csp';

interface Props {
  title?: string;
  description?: string;
  /** Base-relative target for retired URLs that forward to a current route. */
  redirectTo?: string;
  /** The 404 page: served for any missing URL, so it is noindex and declares no canonical. */
  notFound?: boolean;
  /** `instrument` is the full-viewport simulator; everything else is a notebook page. */
  variant?: 'instrument' | 'notebook';
}

const rawBase = import.meta.env.BASE_URL;
const base = normalizeBase(rawBase);
const pageTitle = Astro.props.title;
const variant = Astro.props.variant ?? 'notebook';
const title = pageTitle ? `${pageTitle} · ${siteName}` : siteName;
const defaultDescription = 'A C11 and raylib solar system simulator running in the browser: SI-unit N-body physics starting from the real sky of 2026-06-09.';
const description = Astro.props.description || (pageTitle ? `${pageTitle}. ${defaultDescription}` : defaultDescription);
const redirectTarget = Astro.props.redirectTo !== undefined ? withBase(base, Astro.props.redirectTo) : undefined;
const notFound = Astro.props.notFound === true;
const canonicalUrl = new URL(redirectTarget ?? (notFound ? base : Astro.url.pathname), 'https://jonathanperis.github.io').href;
const csp = contentSecurityPolicy(Boolean(import.meta.env.PUBLIC_GA_ID));
// Link previews (WhatsApp, Slack, social sites) need an absolute image URL.
// tools/site_images.mjs renders the card and the icons into docs/public/.
const socialImage = new URL(`${base}social-preview.png`, 'https://jonathanperis.github.io').href;
const socialImageAlt = 'Solar System Simulator: Jupiter and the Galilean moons rendered by the simulator, beside the title on warm paper.';
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const activeRoute = primaryRoutes.find(route => currentPath.startsWith(withBase(base, route.href)));
---
<!doctype html>
<html lang="en" class={variant}>
  <head>
    <meta charset="utf-8" />
    {/* First in <head>: a meta CSP governs only resources requested after it. */}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Route validation requires this marker on every published HTML document (A60). */}
    <meta name="generator" content={Astro.generator} />
    {redirectTarget !== undefined && <script src={`${base}scripts/forward.js`} data-target={redirectTarget}></script>}
    {/* Without scripts the meta refresh still forwards (dropping the query);
         inside <noscript> it cannot race forward.js in browsers that run it. */}
    {redirectTarget !== undefined && <noscript><meta http-equiv="refresh" content={`0;url=${redirectTarget}`} /></noscript>}
    {(redirectTarget !== undefined || notFound) && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="theme-color" content={variant === 'instrument' ? '#111419' : '#f6f1e7'} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    {/* Self-hosted OFL fonts (public/fonts). */}
    <link rel="preload" href={`${base}fonts/jetbrains-mono-latin.woff2`} as="font" type="font/woff2" crossorigin />
    {variant === 'notebook' && <link rel="preload" href={`${base}fonts/cormorant-garamond-latin.woff2`} as="font" type="font/woff2" crossorigin />}
    <link rel="stylesheet" href={`${base}styles/global.css`} />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-current={currentPath === base ? 'page' : undefined}>{siteName}</a>
      <nav aria-label="Main">
        {primaryRoutes.map((route) => (
          <a data-primary-nav-link href={withBase(base, route.href)} aria-current={activeRoute === route ? 'page' : undefined}>{route.label}</a>
        ))}
        <a href={repoUrl}>Source</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    {variant === 'notebook' && (
      <footer class="site-footer" data-site-footer>
        <p>By {authorName}. C11, raylib, Emscripten and Astro. Build <code>{buildRevision}</code>. Textures: <a href="https://www.solarsystemscope.com/textures/">Solar System Scope</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. <a href={`${base}about/#credits`}>Credits, data and analytics</a>.</p>
      </footer>
    )}
  </body>
</html>
